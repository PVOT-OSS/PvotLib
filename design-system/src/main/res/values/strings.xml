<resources>
    <!-- Suffixes shown next to a picker wheel's value -->
    <string name="pvot_picker_suffix_hours">hours</string>
    <string name="pvot_picker_suffix_minutes">min</string>
    <string name="pvot_picker_suffix_seconds">sec</string>

    <!-- Spoken names for each picker wheel -->
    <string name="pvot_picker_label_hours">Hours</string>
    <string name="pvot_picker_label_minutes">Minutes</string>
    <string name="pvot_picker_label_seconds">Seconds</string>

    <!-- Accessibility actions for moving a picker wheel -->
    <string name="pvot_picker_action_next">Next value</string>
    <string name="pvot_picker_action_previous">Previous value</string>

    <!-- Badge on a navigation bar tab: the count when it is too large to show, and its spoken form -->
    <string name="pvot_nav_badge_overflow">%1$d+</string>
    <plurals name="pvot_nav_badge_description">
        <item quantity="one">%1$d new item</item>
        <item quantity="other">%1$d new items</item>
    </plurals>

    <!-- Top bar: spoken label of the back button -->
    <string name="pvot_top_bar_back">Back</string>

    <!-- Snackbar: spoken label of the close button -->
    <string name="pvot_snackbar_dismiss">Dismiss</string>

    <!-- Call button: spoken state of a toggle such as mute or speaker -->
    <string name="pvot_state_on">On</string>
    <string name="pvot_state_off">Off</string>

    <!-- Keypad: spoken label of the button that deletes the last digit -->
    <string name="pvot_keypad_backspace">Backspace</string>

    <!-- Accessibility actions for moving a persistent sheet -->
    <string name="pvot_sheet_action_collapse">Collapse</string>
    <string name="pvot_sheet_action_medium">Show half</string>
    <string name="pvot_sheet_action_expand">Expand</string>
</resources>
