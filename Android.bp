// The in-tree library modules reach the app through defaults rather than through
// its static_libs, because generateBp rewrites every static_libs block in
// app/Android.bp. Soong merges what defaults contribute with the generated list.
java_defaults {
    name: "PvotLocalLibsDefaults",

    static_libs: [
        "PvotCoreUi",
        "PvotDesignSystem",
    ],
}
