<resources>

    <style name="PvotShapeAppearance.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/pvot_corner_small</item>
    </style>

    <style name="PvotShapeAppearance.Card" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/pvot_corner_card</item>
    </style>

    <style name="PvotShapeAppearance.Selection" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/pvot_corner_selection</item>
    </style>

    <style name="PvotShapeAppearance.Overlay" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/pvot_corner_overlay</item>
    </style>

    <style name="PvotShapeAppearance.Pill" parent="ShapeAppearance.Material3.Corner.Full" />

    <style name="PvotTextAppearance.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:letterSpacing">0.03125</item>
    </style>

    <style name="PvotWidget.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/pvot_card_container</item>
        <item name="shapeAppearance">@style/PvotShapeAppearance.Card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="PvotWidget.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="liftOnScroll">false</item>
    </style>

    <style name="PvotWidget.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="shapeAppearance">@style/PvotShapeAppearance.Pill</item>
    </style>

    <style name="PvotWidget.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="shapeAppearance">@style/PvotShapeAppearance.Pill</item>
    </style>

    <style name="PvotWidget.Button.Dialog" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/pvot_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginLeft">@dimen/pvot_spacing_s</item>
        <item name="android:layout_marginStart">@dimen/pvot_spacing_s</item>
        <item name="android:layout_marginTop">@dimen/pvot_spacing_xs</item>
        <item name="android:layout_marginBottom">@dimen/pvot_spacing_xs</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="backgroundTint">@color/pvot_dialog_action_primary</item>
        <item name="android:textColor">@color/pvot_dialog_action_on_primary</item>
    </style>

    <style name="PvotWidget.Button.Dialog.Neutral" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/pvot_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginLeft">@dimen/pvot_spacing_s</item>
        <item name="android:layout_marginStart">@dimen/pvot_spacing_s</item>
        <item name="android:layout_marginTop">@dimen/pvot_spacing_xs</item>
        <item name="android:layout_marginBottom">@dimen/pvot_spacing_xs</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="backgroundTint">@color/pvot_dialog_action_neutral</item>
        <item name="android:textColor">@color/pvot_dialog_action_on_neutral</item>
    </style>

    <style name="PvotWidget.ButtonBar.AlertDialog" parent="Widget.AppCompat.ButtonBar">
        <item name="android:paddingLeft">@dimen/pvot_spacing_m</item>
        <item name="android:paddingRight">@dimen/pvot_spacing_m</item>
        <item name="android:paddingBottom">@dimen/pvot_spacing_m</item>
    </style>

    <style name="PvotWidget.MaterialAlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?attr/colorSurfaceVariant</item>
    </style>

    <style name="PvotThemeOverlay.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/PvotWidget.MaterialAlertDialog</item>
        <item name="buttonBarStyle">@style/Widget.AppCompat.ButtonBar</item>
        <item name="buttonBarPositiveButtonStyle">@style/PvotWidget.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/PvotWidget.Button.Dialog.Neutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/PvotWidget.Button.Dialog.Neutral</item>
    </style>

    <style name="PvotThemeOverlay.Dialog.Alert" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/pvot_dialog_background</item>
        <item name="buttonBarStyle">@style/PvotWidget.ButtonBar.AlertDialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/PvotWidget.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/PvotWidget.Button.Dialog.Neutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/PvotWidget.Button.Dialog.Neutral</item>
    </style>

</resources>
