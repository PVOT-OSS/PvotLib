<!-- Lenia Sans in the weights PvotTypography uses; app: attributes load it below API 26. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/pvot_lenia_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/pvot_lenia_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/pvot_lenia_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/pvot_lenia_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/pvot_lenia_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/pvot_lenia_sans_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/pvot_lenia_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/pvot_lenia_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
